# Strict source-only repository policy
*
!/.gitignore
!/LICENSE
!/NOTICE
!/README.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/.agents/
!/.agents/skills/
!/.agents/skills/subtitle-removal-captioning/
!/.agents/skills/subtitle-removal-captioning/SKILL.md
!/configs/
!/configs/*.example.json
!/src/
!/src/subtitle_toolkit/
!/src/subtitle_toolkit/*.py
!/tests/
!/tests/*.py

# Defense in depth (the leading allowlist already excludes these)
**/.git/**
**/.svn/**
**/__pycache__/**
**/.pytest_cache/**
**/.mypy_cache/**
**/.ruff_cache/**
**/.venv/**
**/venv/**
**/cache/**
**/caches/**
**/logs/**
**/models/**
**/*.log
**/*.py[cod]
**/*.caption.json
**/*.srt
**/*.ass
**/*.vtt
**/*.mp4
**/*.mkv
**/*.mov
**/*.avi
**/*.wav
**/*.mp3
**/*.onnx
**/*.pdparams
**/*.pth
**/*.pt
**/*.bin
**/*.exe
**/*.dll
**/*.so
**/*.dylib
